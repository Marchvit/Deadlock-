{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlock Counterpick",
  "version": "1.0.0",
  "identifier": "com.deadlockcounterpick.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Deadlock Counterpick",
        "width": 1320,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Контрпик и тренировка для Deadlock",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["Russian"]
      }
    }
  }
}
